# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=photo
DB_PASSWORD=photo_dev
DB_NAME=photo_club
DB_POOL_SIZE=10

# 生产环境必须显式配置（>=32 字符），否则服务拒绝启动
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars-min
# 会话时效（点5）：access 8 小时 / refresh 30 天，减少频繁登出
ACCESS_TOKEN_TTL_SECONDS=28800
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
LOG_LEVEL=info
