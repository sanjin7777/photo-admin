# 复制为 .env.production 后由 deploy.sh 自动补齐所有留空项，并 chmod 600。
# 请勿把本文件提交到公开仓库。
NODE_ENV=production

# 对外访问地址，用于 CORS / CSRF 白名单。必须与浏览器地址栏完全一致：含协议、无末尾斜杠。
PUBLIC_ORIGIN=https://www.catpaw.art

# 仅用于部署日志；留空时 deploy.sh 自动探测公网 IP
SERVER_IP=

# 留空时自动生成 64 位随机十六进制
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_ACCESS_SECRET=

# 种子账号统一密码，留空时自动生成；init-seed.sh 用它在容器内重算 bcrypt 哈希
SEED_PASSWORD=

# Excel 批量导入的临时密码不再由部署配置提供：每批导入随机生成，
# 结果页一次性回显，账号首次登录必须改密。

# 端口规划（与已有项目隔离）
#   127.0.0.1:8081  宝塔 Nginx 的整站反代目标，不对公网开放
#   127.0.0.1:3307  MySQL，仅本机
#   server 容器无宿主端口映射，只能经 Nginx 反代访问
#   80 / 443        由宝塔 Nginx 占用，承载域名与 SSL
